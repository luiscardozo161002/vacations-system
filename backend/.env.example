NODE_ENV=development
HOST=0.0.0.0
PORT=3000

DB_HOST=localhost
DB_PORT=5432
DB_NAME=vacations_db
DB_USER=postgres
DB_PASSWORD=postgres

# Firma los access token (JWT). En produccion es obligatorio y no puede quedarse con este valor.
JWT_SECRET=dev-secret-change-me-in-production

# Origenes que pueden llamar a la API desde el navegador, separados por coma
CORS_ORIGINS=http://localhost:5173
