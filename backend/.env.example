NODE_ENV=development
HOST=0.0.0.0
PORT=3000

DB_HOST=localhost
DB_PORT=5432
DB_NAME=vacations_db
DB_USER=postgres
DB_PASSWORD=postgres

# Firma los access token (JWT). En produccion es obligatorio y no puede quedarse con este valor.
JWT_SECRET=dev-secret-change-me-in-production

# Vida del access token (minutos), de la sesion (dias) y del codigo para restablecer la contraseña (horas)
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
PASSWORD_RESET_TTL_HOURS=1

# Intentos fallidos seguidos antes de bloquear la cuenta y minutos que dura el bloqueo
MAX_FAILED_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15

# Intentos fallidos permitidos desde una misma IP dentro de la ventana (minutos)
MAX_FAILED_LOGINS_PER_IP=20
FAILED_LOGINS_WINDOW_MINUTES=15

# Origenes que pueden llamar a la API desde el navegador, separados por coma
CORS_ORIGINS=http://localhost:5173

# IPs de los proxies o balanceadores delante de la API, separadas por coma.
# Solo de ellos se acepta X-Forwarded-For para saber la IP real del usuario.
TRUSTED_PROXIES=
