# Environment: development, test or production
NODE_ENV=development
# Address the API listens on
HOST=0.0.0.0
# Port the API listens on
PORT=3000

# PostgreSQL host
DB_HOST=localhost
# PostgreSQL port
DB_PORT=5432
# Database name (required)
DB_NAME=vacations_db
# Database user (required)
DB_USER=postgres
# Database password
DB_PASSWORD=postgres

# Secret that signs the access tokens (required, at least 32 characters in production)
JWT_SECRET=change-me
# Minutes an access token stays valid
ACCESS_TOKEN_TTL_MINUTES=15
# Days a refresh token stays valid
REFRESH_TOKEN_TTL_DAYS=7
# Hours a password reset link stays valid
PASSWORD_RESET_TTL_HOURS=1

# Failed logins in a row that lock an account
MAX_FAILED_LOGIN_ATTEMPTS=5
# Minutes an account stays locked
LOCKOUT_MINUTES=15
# Failed logins allowed from one IP inside the window
MAX_FAILED_LOGINS_PER_IP=20
# Minutes the failed logins per IP are counted
FAILED_LOGINS_WINDOW_MINUTES=15

# Web origins allowed to call the API, separated by commas
CORS_ORIGINS=http://localhost:5173
# IPs of the reverse proxies whose X-Forwarded-For header is trusted, separated by commas
TRUSTED_PROXIES=
# Prefix the runtime adds to IPv4 addresses, removed before saving the client IP
IPV4_MAPPED=::ffff:

# Request fields that are never written to the audit log, separated by commas
SECRET_FIELDS=password,currentPassword,newPassword
# Characters of the user agent saved in the audit log
MAX_USER_AGENT_LENGTH=255
# Characters of the request id saved in the audit log
MAX_REQUEST_ID_LENGTH=64
# Tolerance used when comparing hours so decimal rounding does not change a balance
EPSILON=0.000001

# Role code with access to every company and branch
ROLE_GLOBAL=SUPERUSER
# Role code limited to its own branches
ROLE_SCOPED=USER

# Bcrypt cost used to hash the passwords
PASSWORD_SALT_ROUNDS=10
# Random bytes of the refresh and reset tokens
TOKEN_BYTES=32
# Characters used to build a temporary password
TEMP_PASSWORD_ALPHABET=ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnpqrstuvwxyz23456789
# Length of a temporary password
TEMP_PASSWORD_LENGTH=10
# Months a temporary password stays valid
TEMP_PASSWORD_VALID_MONTHS=1

# Hours of a working day when the shift has no schedule
DEFAULT_DAILY_HOURS=8
# Days before a period ends when the reminder is sent
REMINDER_DAYS=7
# Hours between the automatic generation of vacation periods (1 to 500)
ROLLOVER_INTERVAL_HOURS=24
# First year of the federal government transfer holiday
FIRST_TRANSFER_YEAR=2024
# Years between transfer holidays
TRANSFER_EVERY_YEARS=6

# Rows per page when the request does not ask for a size
PAGE_SIZE_DEFAULT=20
# Largest page size a request can ask for
PAGE_SIZE_MAX=100
# Shortest password allowed
PASSWORD_MIN_LENGTH=8
# Longest password allowed
PASSWORD_MAX_LENGTH=100
# Largest range in days the calendar accepts
CALENDAR_MAX_RANGE_DAYS=62
# Days ahead the dashboard looks for upcoming absences
DASHBOARD_UPCOMING_DAYS=30
# Rows in each dashboard list
DASHBOARD_LIST_LIMIT=4
# Rows in the own requests list of the dashboard
DASHBOARD_MY_LIST_LIMIT=5
# Notifications returned to the top bar
NOTIFICATIONS_LIST_LIMIT=20
# Pending requests turned into notifications
NOTIFICATIONS_PENDING_LIMIT=10

# Time zone used to print the dates of the notice PDF
TIME_ZONE=America/Mexico_City
# Phone line printed on the notice PDF when the company has none
PDF_DEFAULT_PHONE=TEL. 01-773-78-50497 / 504-98 / 500-09      FAX 506-22
# Name of the area that signs the notice PDF
PDF_MANAGER_NAME=RECURSOS HUMANOS
# Milliseconds to wait for the company logo before printing the PDF without it
PDF_LOGO_TIMEOUT_MS=3000

# true adds the byte order mark so Excel opens the CSV files with accents
CSV_INCLUDE_BOM=true
# Message Hapi returns for a malformed JSON body, used to detect that error
INVALID_JSON_MESSAGE=Invalid request payload JSON format
