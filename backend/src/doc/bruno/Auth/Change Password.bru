meta {
  name: Change Password
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/api/v1/auth/me/password
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "currentPassword": "Vacaciones2026!",
    "newPassword": "Vacaciones2026!"
  }
}

script:post-response {
  if (res.status === 200) {
    bru.setVar("accessToken", res.body.accessToken);
    bru.setVar("refreshToken", res.body.refreshToken);
  }
}

docs {
  Cambia la contraseña del usuario actual. Revoca todas sus sesiones (otros dispositivos tendran que volver a iniciar sesion) y devuelve `accessToken` y `refreshToken` nuevos para esta sesion. `newPassword` va de 8 a 100 caracteres.

  Errores: `400 INVALID_CURRENT_PASSWORD` si la contraseña actual no coincide.
}
