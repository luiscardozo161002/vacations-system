meta {
  name: Logout
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/v1/auth/logout
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "refreshToken": "pegar-aca-el-refreshToken-del-login"
  }
}

docs {
  Revoca esa sesion. Responde 204 exista o no el token (para no revelar si era valido).
}
