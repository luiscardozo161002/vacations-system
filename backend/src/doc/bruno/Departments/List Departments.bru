meta {
  name: List Departments
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/departments?status=active&page=1&pageSize=20
  body: none
  auth: inherit
}

params:query {
  status: active
  page: 1
  pageSize: 20
  ~branch_id: 5
}

docs {
  Lista departamentos paginada. Filtros opcionales: `branch_id`, `status` (`active`/`inactive`).
}
