}

params:path {
  departmentId: 1
}

body:json {
  {
    "department_name": "Recursos Humanos y Nomina"
  }
}

docs {
  Actualizacion parcial: solo se envian los campos a modificar (al menos uno). Mismos codigos de error 422/409 que la creacion.
}
