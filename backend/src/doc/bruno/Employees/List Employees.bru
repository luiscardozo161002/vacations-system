meta {
  name: List Employees
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/employees?status=active&page=1&pageSize=10
  body: none
  auth: inherit
}

params:query {
  status: active
  page: 1
  pageSize: 10
  ~department_id: 1
  ~search: perez
  ~company_id: 2
}

docs {
  Lista empleados paginada. Filtros opcionales: `company_id`, `search` (parte del nombre o del numero, sin importar mayusculas), `department_id`, `status` (`active`/`inactive`).
  Respuesta: `{ data, pagination: { page, pageSize, total } }`.
}
