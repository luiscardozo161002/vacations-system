meta {
  name: List Employees
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/employees?status=active&page=1&pageSize=10
  body: none
  auth: none
}

params:query {
  status: active
  page: 1
  pageSize: 10
  ~department_id: 1
}

docs {
  Lista empleados paginada. Filtros opcionales: `department_id`, `status` (`active`/`inactive`).
  Respuesta: `{ data, pagination: { page, pageSize, total } }`.
}
