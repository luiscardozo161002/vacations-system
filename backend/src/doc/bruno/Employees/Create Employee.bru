meta {
  name: Create Employee
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/v1/employees
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "department_id": 1,
    "shift_id": 1,
    "folio": "EMP-001",
    "employee_number": "0001",
    "employee_name": "Juan Perez",
    "start_date": "2026-01-01",
    "status": "active"
  }
}

docs {
  Requeridos: `department_id`, `shift_id`, `folio`, `employee_number`, `employee_name`, `start_date`.
  `status` es opcional (default `active`).

  Errores: `422 INVALID_DEPARTMENT` / `INVALID_SHIFT` si los ids no existen; `409 EMPLOYEE_NUMBER_EXISTS` si `employee_number` ya esta en uso.
}
