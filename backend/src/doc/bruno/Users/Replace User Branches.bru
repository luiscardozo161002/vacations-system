meta {
  name: Replace User Branches
  type: http
  seq: 7
}

put {
  url: {{baseUrl}}/api/v1/users/:userId/branches
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

params:path {
  userId: 2
}

body:json {
  {
    "branch_ids": [5]
  }
}

docs {
  Reemplaza todas las sedes del usuario y devuelve las nuevas. Se aplican en su siguiente token (hasta 15 minutos).

  Errores: `422 INVALID_BRANCH` si alguna sede no existe.
}
