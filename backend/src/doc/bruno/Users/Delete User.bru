meta {
  name: Delete User
  type: http
  seq: 5
}

delete {
  url: {{baseUrl}}/api/v1/users/:userId
  body: none
  auth: none
}

params:path {
  userId: 1
}

docs {
  Borrado fisico. Si el usuario ya inicio sesion, pidio un reset de password o tiene eventos en el log de auditoria, responde `409 RELATED_RECORDS` (esas tablas lo referencian y auth-audit-log no se puede borrar via API).
}
