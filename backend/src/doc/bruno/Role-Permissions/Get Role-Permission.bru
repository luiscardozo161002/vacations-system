meta {
  name: Get Role-Permission
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/v1/role-permissions/:roleId/:permissionId
  body: none
  auth: none
}

params:path {
  roleId: 1
  permissionId: 1
}

docs {
  Verifica si ese permiso esta asignado a ese rol. 404 `ROLE_PERMISSION_NOT_FOUND` si no.
}
