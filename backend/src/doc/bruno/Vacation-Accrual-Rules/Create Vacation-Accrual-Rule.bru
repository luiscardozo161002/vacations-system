meta {
  name: Create Vacation-Accrual-Rule
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/v1/vacation-accrual-rules
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "years_from": 36,
    "years_to": 40,
    "vacation_days": 34,
    "effective_year": 2023
  }
}

docs {
  Requeridos: `years_from`, `vacation_days`, `effective_year`. `years_to` opcional (acepta `null` = sin tope). `status` opcional (default `active`).

  La base valida con un CHECK que `years_to >= years_from`; si se incumple responde 400 generico (`INVALID_CONSTRAINT`).
}
