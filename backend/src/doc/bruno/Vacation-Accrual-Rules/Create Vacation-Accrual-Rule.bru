meta {
  name: Create Vacation-Accrual-Rule
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/v1/vacation-accrual-rules
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "years_from": 36,
    "years_to": 40,
    "vacation_days": 34,
    "effective_year": 2023
  }
}

docs {
  Requeridos: `years_from`, `vacation_days`, `effective_year`. `years_to` opcional (acepta `null` = sin tope). `status` opcional (default `active`).

  Errores: `422 INVALID_RULE_RANGE` si `years_to` es menor que `years_from`; `409 RULE_OVERLAP` si el rango se cruza con otra regla activa del mismo `effective_year`.
}
