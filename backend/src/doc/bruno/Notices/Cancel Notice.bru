meta {
  name: Cancel Notice
  type: http
  seq: 5
}

delete {
  url: {{baseUrl}}/api/v1/notices/:noticeId
  body: none
  auth: inherit
}

params:path {
  noticeId: 1
}

docs {
  No es baja logica con `status = 'inactive'` (esa tabla no admite ese valor): pone `status = 'cancelled'`. 204 sin contenido.
}
