# API base URL, without the /api/v1 prefix
VITE_API_BASE_URL=http://localhost:3000

# Rows per page in the tables
VITE_PAGE_SIZE=10
# Rows requested when a list feeds a selector or a card grid (the API maximum is PAGE_SIZE_MAX)
VITE_CATALOG_PAGE_SIZE=100
# Shortest password the forms accept, same value as PASSWORD_MIN_LENGTH in the backend
VITE_PASSWORD_MIN_LENGTH=8

# Milliseconds the search boxes wait after the last key
VITE_SEARCH_DELAY_MS=300
# Milliseconds a toast stays on screen
VITE_TOAST_MS=3200
# Milliseconds a response is reused before it is requested again
VITE_STALE_TIME_MS=30000

# First year of the accrual rules after the "vacaciones dignas" reform
VITE_LFT_REFORM_YEAR=2023

# Role code with access to every branch, same value as ROLE_GLOBAL in the backend
VITE_ROLE_GLOBAL=SUPERUSER
# Role code limited to its own branches, same value as ROLE_SCOPED in the backend
VITE_ROLE_SCOPED=USER
# Role code of the employees
VITE_ROLE_EMPLOYEE=EMPLOYEE
